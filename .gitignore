# ---------------------------------------------------------------
# Private. Never publish. Spoilers, local runs, personal notes.
# ---------------------------------------------------------------

# Challenge answer bundles: the patch that solves the bug.
*-answers.tar.gz
*answers.tar.gz
**/answers/

# Forge output: generated challenges, work trees, solved states. local_output/
# is matched by *_output/ and is named again below, because it holds the
# no-AWS run's state and its secrets file.
phase3_output/
phase5_output/
phase*_output/
*_output/
out/
work/

# Cloned repos, venvs and baseline test runs from local forging.
cache/
.baseline_cache/
.forge_cache/

# Personal / assistant scratch
.claude/
.cursor/
.aider*
NOTES.md
TODO.md
scratch/
*.local.md

# ---------------------------------------------------------------
# Secrets & credentials
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
.aws/
aws-exports.js
amplify/
samconfig.toml
*.tfvars
.terraform/

# Shell files that export credentials. local_output/secrets.sh holds a real
# GitHub OAuth client secret and the session signing key, so it is matched
# here as well as by *_output/ -- one rule failing must not be enough to
# commit it. A *secrets.example.sh template, which holds no values, is
# allowed through so a placeholder can be committed if one is ever wanted.
secrets.sh
*secrets.sh
!*secrets.example.sh

