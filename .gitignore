# ---------------------------------------------------------------
# LocalStack state (infra/local/docker-compose.yml mounts it)
# ---------------------------------------------------------------
infra/local/volume/
infra/local/.build/

# ---------------------------------------------------------------
# The no-AWS deploy (server/app.py + cloud/local_store.py)
# ---------------------------------------------------------------
# local_store backs S3 with a directory and DynamoDB with a SQLite file,
# under whatever BUGFORGE_LOCAL_STORE points at. The default is inside
# local_output/, but the path is configurable, so the store's own file
# shapes are matched wherever it is pointed.
local_output/
store/
*.sqlite
*.sqlite3
*.db-journal
*.db-wal

# Per-machine environment for that run. Written against whatever repo and
# store this machine has; never useful to a reader.
local_output/env.sh
local_output/run_api.sh

# ---------------------------------------------------------------
# Next.js static export (web/.gitignore also covers this)
# ---------------------------------------------------------------
# `npm run build` with output: "export" writes web/out/, which is the
# deployable artifact and is rebuilt from source every time.
web/out/
web/.next/

# ---------------------------------------------------------------
# Local run state. Generated per machine; never useful to a reader.
# ---------------------------------------------------------------
# Written by env_vars.py / localize.py against whatever stack is up locally.
infra/local/env.json
infra/local/container-env.json
infra/local/event-repos.json

# Vendored clones and per-repo virtualenvs from local forging. These were
# tracked once, which is how six venvs and the answer tarballs reached the
# history; they are untracked now and must not come back.
cache/**
*__venv/
*_output/**

# ---------------------------------------------------------------
# Demo notes. Written for the person presenting, not for a reader
